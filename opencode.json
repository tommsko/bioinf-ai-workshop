{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/kimi-k3",
  "permission": {
    "*": "deny",
    "edit": "allow",
    "write": "allow",
    "execute": "allow",
    "skill": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "subagent": "allow",
    "metacentrum_*": "allow"
  },
  "mcp": {
    "servers": {
      "metacentrum": {
        "type": "local",
        "command": ["metacentrum-mcp", "serve"],
        "environment": { "METACENTRUM_MCP_MAX_WAIT": "120" },
        "timeout": 180000
      }
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://llm.ai.e-infra.cz/v1"
      },
      "models": {
        "kimi-k3": { "name": "kimi-k3" },
        "glm-5.3": { "name": "glm-5.3" },
        "glm-5.3-flash": { "name": "glm-5.3-flash" },
        "deepseek-v4.1-flash": { "name": "deepseek-v4.1-flash" },
        "deepseek-v4.1-flash-thinking": { "name": "deepseek-v4.1-flash-thinking" },
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": { "context": 280000, "output": 280000 }
        },
        "qwen3.8-flash-next": {
          "name": "qwen3.8-flash-next",
          "limit": { "context": 280000, "output": 280000 }
        },
        "mistral-medium-3.5": { "name": "mistral-medium-3.5" },
        "gemma4": { "name": "gemma4" },
        "gpt-oss-120b": { "name": "gpt-oss-120b" },
        "agentic": { "name": "agentic (alias)" },
        "coder": { "name": "coder (alias)" },
        "thinker": { "name": "thinker (alias)" },
        "mini": { "name": "mini (alias)" }
      }
    }
  }
}
